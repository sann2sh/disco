[Unit]
Description=disco – audio-reactive ASUS TUF keyboard backlight
Documentation=https://github.com/sann2sh/disco
# Wait for the audio session (PipeWire / PulseAudio) to be ready.
After=graphical-session.target pipewire.service pulseaudio.service
Wants=graphical-session.target

[Service]
Type=simple

# PYTHON_BIN and DISCO_SCRIPT are filled in by install.sh
ExecStart=PYTHON_BIN DISCO_SCRIPT --beat

# Restart automatically if it crashes (e.g. audio device disappeared).
Restart=on-failure
RestartSec=5

# Nice logging via journalctl --user -u disco
StandardOutput=journal
StandardError=journal

# Low priority so it doesn't compete with audio processing
Nice=10

[Install]
WantedBy=default.target
